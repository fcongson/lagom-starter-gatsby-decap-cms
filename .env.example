# Environment Variables
# Copy this file to .env.development and .env.production
# and fill in your actual values

# Site Configuration
GATSBY_SITE_URL=https://your-site.netlify.app

# Analytics & Tracking
GATSBY_GOOGLE_ANALYTICS_ID=
GATSBY_GOOGLE_TAG_MANAGER_ID=
GATSBY_FACEBOOK_PIXEL_ID=

# CMS Configuration
GATSBY_CMS_MANUAL_INIT=true

# API Keys (if using external services)
GATSBY_MAILCHIMP_API_KEY=
GATSBY_FORMSPREE_FORM_ID=
GATSBY_CLOUDINARY_CLOUD_NAME=

# Feature Flags
GATSBY_ENABLE_DARK_MODE=true
GATSBY_ENABLE_SEARCH=true
GATSBY_ENABLE_COMMENTS=false

# Development
GATSBY_WEBPACK_PUBLICPATH=/
